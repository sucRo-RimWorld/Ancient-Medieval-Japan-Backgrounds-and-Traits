<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Suppress naturally rolled BodyPurist; retain TraitDef and old saved pawns. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/TraitDef[defName="BodyPurist"]/commonality</xpath>
    <value><commonality>0</commonality></value>
  </Operation>
  <!-- Also prevent the two original Core backgrounds from forcing BodyPurist. -->
  <!-- Original Core BackstoryTrait uses <BodyPurist>0</BodyPurist>, not li/key/value. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BackstoryDef[defName="HunterOfTheKing53" or defName="TestSubject90"]/forcedTraits/BodyPurist</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/BackstoryDef[defName="HunterOfTheKing53" or defName="TestSubject90"]/forcedTraits/BodyPurist</xpath>
    </match>
  </Operation>
</Patch>
