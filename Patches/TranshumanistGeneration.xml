<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Suppress ordinary random rolling, while retaining the TraitDef for existing pawns. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/TraitDef[defName="Transhumanist"]/commonality</xpath>
    <value>
      <commonality>0</commonality>
    </value>
  </Operation>
  <!-- Keep original backstory/trait IDs while removing its forced Transhumanist link. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BackstoryDef[defName="FerventResearcher72"]/forcedTraits/li[key="Transhumanist" or traitDef="Transhumanist"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/BackstoryDef[defName="FerventResearcher72"]/forcedTraits/li[key="Transhumanist" or traitDef="Transhumanist"]</xpath>
    </match>
  </Operation>
  <!-- This SF adult backstory is not suitable for ordinary period-Japanese generation.
       Preserve its Def for saved pawns but make its categories ineligible. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/BackstoryDef[defName="FerventResearcher72"]/spawnCategories</xpath>
    <value>
      <spawnCategories>
        <li>AMJ_CultureExcluded</li>
      </spawnCategories>
    </value>
  </Operation>
</Patch>
